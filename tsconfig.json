{
  "compilerOptions": {
    "types": ["nativewind/types"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@screens/*": ["./src/screens/*"],
      "@utils/*": ["./src/utils/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@constants/*": ["./src/constants/*"],
      "@store/*": ["./src/store/*"]
    },
    "lib": ["es2015", "dom"]
  },
  "extends": "expo/tsconfig.base",
  "include": ["**/*.ts", "**/*.tsx", "nativewind.d.ts", "nativewind-env.d.ts"]
}
